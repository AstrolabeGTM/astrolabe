#!/bin/bash
# Runs on every boot; each step is idempotent. The VM runs the published
# Astrolabe image with Postgres via docker compose, behind Caddy (HTTPS).
set -euo pipefail

if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
if ! command -v caddy >/dev/null; then
  apt-get update
  apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl gnupg
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' > /etc/apt/sources.list.d/caddy-stable.list
  apt-get update
  apt-get install -y caddy
fi

mkdir -p /opt/astrolabe/products
cat > /etc/caddy/Caddyfile <<CADDY
${domain} {
  reverse_proxy 127.0.0.1:8080
  request_body {
    max_size 2MB
  }
}
CADDY
systemctl reload caddy || systemctl restart caddy

# The server runs as uid 10001; the products folder is shipped by deploy.sh.
cat > /opt/astrolabe/compose.yaml <<'COMPOSE'
services:
  postgres:
    image: postgres:17
    environment: {POSTGRES_USER: astrolabe, POSTGRES_PASSWORD: astrolabe, POSTGRES_DB: astrolabe}
    volumes: [pgdata:/var/lib/postgresql/data]
    healthcheck: {test: ["CMD", "pg_isready", "-U", "astrolabe"], interval: 2s, retries: 30}
    restart: unless-stopped
  astrolabe:
    image: ghcr.io/astrolabegtm/astrolabe:${image_tag}
    env_file: .env
    environment:
      ASTROLABE_DATABASE_URL: postgres://astrolabe:astrolabe@postgres:5432/astrolabe?sslmode=disable
    ports: ["127.0.0.1:8080:8080"]
    volumes: ["./products:/data/products", "secrets:/data/secrets"]
    depends_on: {postgres: {condition: service_healthy}}
    restart: unless-stopped
volumes:
  pgdata:
  secrets:
COMPOSE

# The env file (ASTROLABE_* settings) comes from Secret Manager.
cat > /opt/astrolabe/start.sh <<'START'
#!/bin/bash
set -euo pipefail
cd /opt/astrolabe
gcloud secrets versions access latest --secret=${secret} > .env.tmp
grep -q '^TZ=' .env.tmp || echo "TZ=UTC" >> .env.tmp
install -m 0600 .env.tmp .env && rm .env.tmp
docker compose pull -q
docker compose up -d
START
chmod 0755 /opt/astrolabe/start.sh

# Daily compressed dump to the versioned bucket at 03:15.
cat > /etc/cron.d/astrolabe-backup <<CRON
15 3 * * * root cd /opt/astrolabe && docker compose exec -T postgres pg_dump -U astrolabe -Fc astrolabe | gcloud storage cp - gs://${bucket}/astrolabe-\$(date +\%F).dump
CRON

/opt/astrolabe/start.sh || echo "start failed: add the astrolabe-env secret, then run /opt/astrolabe/start.sh"
